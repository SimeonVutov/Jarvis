# Jarvis — gitignore

# Generated by installer — contains your personal config and model names
config.json

# All runtime data — databases, vector index, encryption salt
data/

# Python virtual environment
venv/

# Generated launch scripts
start-dashboard.sh
start-terminal.sh

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Misc
.DS_Store
*.swp
*.swo
